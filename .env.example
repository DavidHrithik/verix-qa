
# Verix QA — Environment Configuration
# Copy this file to .env.local and fill in your values.

# ─── Azure AI Foundry (gpt-5.6-sol) ────────────────────────────────────────────
# Your Azure API Key (from Microsoft Foundry → Build → Deployments → Keys)
VITE_OPENAI_API_KEY=

# Azure endpoint for your project (copy from the playground "Call model" tab)
VITE_OPENAI_BASE_URL=https://aif-hackathon-nonprod-eastus-001.services.ai.azure.com/openai/v1

# Deployment name — default is gpt-5.6-sol, change if you deploy a different model
VITE_OPENAI_MODEL=gpt-5.6-sol
